{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/session_start.mjs\"",
        "timeoutSec": 5
      }
    ],
    "userPromptSubmitted": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/mode_tracker.mjs\"",
        "timeoutSec": 2
      }
    ]
  }
}
