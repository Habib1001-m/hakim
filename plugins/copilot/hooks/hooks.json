{
  "version": 1,
  "hooks": {
    "sessionStart": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/session_start.mjs\"",
        "env": {
          "HAKIM_PLUGIN_DATA": "${COPILOT_PLUGIN_DATA}"
        },
        "timeoutSec": 5
      }
    ],
    "userPromptTransformed": [
      {
        "type": "command",
        "command": "node \"${PLUGIN_ROOT}/hooks/mode_control.mjs\"",
        "env": {
          "HAKIM_PLUGIN_DATA": "${COPILOT_PLUGIN_DATA}"
        },
        "timeoutSec": 2
      }
    ]
  }
}
